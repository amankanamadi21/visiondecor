# ============================================================
# VisionDecor — environment configuration template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. Secrets live only here.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_APP=backend.app:create_app
SECRET_KEY=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth (D014) ---
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_COOKIE_SECURE=false
# ^ set true in production (HTTPS only)

# --- Database (D013 — PostgreSQL + pgvector, D006a) ---
DATABASE_URL=postgresql+psycopg2://visiondecor:visiondecor_dev_password@localhost:5432/visiondecor
POSTGRES_USER=visiondecor
POSTGRES_PASSWORD=visiondecor_dev_password
POSTGRES_DB=visiondecor

# --- Uploads ---
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- Job runner (Batch 1 — thread-based, stated limitation vs NFR-5) ---
JOB_RUNNER_MAX_WORKERS=2

# --- Render providers (D003) — leave blank until you have keys; system must
#     degrade to cache / floor-plan-only without failing when these are empty ---
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HUGGINGFACE_API_TOKEN=

# --- Feedback-parsing LLM (D007a/D011a — text only, never image, never
#     furniture/price/position decisions) ---
FEEDBACK_LLM_PROVIDER=
FEEDBACK_LLM_API_KEY=

# --- Embeddings for RAG (D006a) — local model, no key needed by default ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
